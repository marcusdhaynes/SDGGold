{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/marcusdhaynes/SDGGold/blob/main/COURSE_PACKAGE_SCHEMA.json",
  "title": "SDGGold External AI Complete Course Package v2",
  "description": "Formal JSON shape; graph semantics, provenance and no-skipping constraints are enforced by course-package.js.",
  "type": "object",
  "required": [
    "schema",
    "course",
    "tracks",
    "sources",
    "coverage",
    "quality",
    "nodes"
  ],
  "properties": {
    "schema": {
      "const": "sdggold-course-v2"
    },
    "course": {
      "type": "object",
      "required": [
        "course_id",
        "title",
        "revision",
        "mastery_node_id",
        "outcomes"
      ],
      "properties": {
        "course_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,99}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "subtitle": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "language": {
          "type": "string"
        },
        "mastery_node_id": {
          "type": "string",
          "minLength": 1
        },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "description"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "purpose",
          "distinctness"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "distinctness": {
            "type": "string"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "rights"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "rights": {
            "type": "string",
            "enum": [
              "original",
              "licensed",
              "public_domain",
              "user_supplied",
              "unknown"
            ]
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "required": [
        "status",
        "source_ledger"
      ],
      "properties": {
        "status": {
          "enum": [
            "complete",
            "partial"
          ]
        },
        "source_ledger": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source_id",
              "processed_locators",
              "missing_locators"
            ],
            "properties": {
              "source_id": {
                "type": "string"
              },
              "processed_locators": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "missing_locators": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "quality": {
      "type": "object",
      "required": [
        "self_checked",
        "checklist",
        "open_questions"
      ],
      "properties": {
        "self_checked": {
          "type": "boolean"
        },
        "checklist": {
          "type": "array",
          "minItems": 12,
          "items": {
            "type": "object",
            "required": [
              "id",
              "passed",
              "notes"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "passed": {
                "type": "boolean"
              },
              "notes": {
                "type": "string"
              }
            }
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/node"
      }
    }
  },
  "$defs": {
    "quiz": {
      "type": "object",
      "required": [
        "question",
        "choices",
        "correct",
        "explanation"
      ],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1
        },
        "choices": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "correct": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sourceRef": {
      "type": "object",
      "required": [
        "source_id",
        "locator"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "title",
        "kind",
        "subject",
        "tier",
        "track_ids",
        "prerequisites",
        "prerequisite_rationales",
        "learn",
        "example",
        "reinforce",
        "practice",
        "test",
        "review",
        "outcome_ids",
        "source_refs",
        "uncertainty"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "concept",
            "skill",
            "milestone"
          ]
        },
        "subject": {
          "type": "string"
        },
        "tier": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "lane": {
          "type": "number",
          "minimum": 0
        },
        "track_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "prerequisite_rationales": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "learn": {
          "type": "string",
          "minLength": 40
        },
        "example": {
          "type": "string",
          "minLength": 1
        },
        "reinforce": {
          "type": "object",
          "required": [
            "question",
            "answer"
          ],
          "properties": {
            "question": {
              "type": "string",
              "minLength": 1
            },
            "answer": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "practice": {
          "$ref": "#/$defs/quiz"
        },
        "test": {
          "$ref": "#/$defs/quiz"
        },
        "review": {
          "$ref": "#/$defs/quiz"
        },
        "outcome_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        },
        "uncertainty": {
          "type": "string"
        }
      }
    }
  }
}
